    {
        "id": "ee3c906c74060c5d",
        "type": "function",
        "z": "60d4e98eb21fcd74",
        "g": "eacd63b966559025",
        "name": "[模拟设备] 执行修改并上报",
        "func": "// 1. 获取云端要修改的属性（比如 { temp: 7 }）\nconst newProps = msg.payload;\n\n// 2. 从全局变量中取出旧状态\nlet temp = flow.get(\"bxsb_latest_temp\") || 4.2;\nlet door = flow.get(\"bxsb_latest_door\") || 0;\n\n// 3. 更新状态（模拟物理设备改变）\nif (newProps.temp !== undefined) temp = newProps.temp;\nif (newProps.door !== undefined) door = newProps.door;\n\n// 4. 把最新状态存回全局变量\nflow.set(\"bxsb_latest_temp\", temp);\nflow.set(\"bxsb_latest_door\", door);\n\n// 5. ⚠️ 关键修改：输出最新的状态（这样 function 7 才能拿到 temp 和 door 去上报）\nmsg.payload = {\n    \"temp\": temp,\n    \"door\": door\n};\n\n// 6. 设置 HTTP 状态码为 200（让 http response 节点直接返回）\nmsg.statusCode = 200;\n\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
