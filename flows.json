        "g": "ec88d0eea0c6be40",
        "name": "[协议转换] 上报数据打包",
        "func": "// 1. 从 HTTP 请求里拿到设备的最新状态\nconst temp = msg.payload.temp;\nconst door = msg.payload.door;\n\n// 2. 缓存最新状态（方便后续云端读取时直接返回）\nflow.set(\"bxsb_latest_temp\", temp);\nflow.set(\"bxsb_latest_door\", door);\n\n// 3. 打包成云平台规定的物模型格式\nmsg.payload = {\n    \"deviceId\": \"bxsb\",\n    \"properties\": {\n        \"temp\": temp,\n        \"door\": door\n    }\n};\n\n// 4. 贴上专属路由标签（极其重要，否则 mqtt out 会报错）\nmsg.topic = \"/bxcp_wg/bxsb_wg/child/bxsb/properties/report\";\n\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
